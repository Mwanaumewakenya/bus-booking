{
    "name": "busBooking/bus-booking-system",
    "description": "A modern, production-ready bus booking system built with PHP",
    "type": "project",
    "version": "2.0.0",
    "keywords": ["bus", "booking", "reservation", "travel", "php"],
    "license": "MIT",
    "authors": [
        {
            "name": "Bus Booking System",
            "email": "info@busbooking.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "phpstan/phpstan": "^1.0",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Controllers\\": "app/Controllers/",
            "App\\Models\\": "app/Models/",
            "App\\Middleware\\": "app/Middleware/",
            "App\\Services\\": "app/Services/",
            "App\\Helpers\\": "app/Helpers/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "analyse": "phpstan analyse app --level=5",
        "lint": "phpcs app --standard=PSR12",
        "lint-fix": "phpcbf app --standard=PSR12",
        "serve": "php -S localhost:8000 -t public",
        "install-prod": [
            "@composer install --no-dev --optimize-autoloader",
            "@composer dump-autoload --optimize"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}