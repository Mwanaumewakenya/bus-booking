# Application Environment Configuration Example
# Copy this file to .env and configure your settings

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_NAME="Bus Booking System"
APP_KEY=your_app_key_here

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=bus_booking
DB_USERNAME=root
DB_PASSWORD=

# Session Configuration
SESSION_LIFETIME=120
SESSION_COOKIE=bus_booking_session
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=
SESSION_ENCRYPT=false

# Security Settings
BCRYPT_ROUNDS=12
CSRF_ENABLED=true
HASH_ALGO=PASSWORD_ARGON2ID

# Logging
LOG_LEVEL=info
LOG_CHANNEL=file
LOG_FILE=storage/logs/app.log

# Email Configuration (Gmail)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=briankirui275@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=briankirui275@gmail.com
MAIL_FROM_NAME="Swift Bus Services"

# Cache Configuration
CACHE_DRIVER=file
CACHE_PREFIX=bus_booking_

# File Storage
FILESYSTEM_DRIVER=local

# M-Pesa Configuration (Safaricom Daraja API)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_BUSINESS_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_here
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback

# Company Information
COMPANY_NAME="Swift Bus Services"
COMPANY_LOGO_URL=https://yourdomain.com/assets/images/logo.png
COMPANY_WEBSITE=https://yourdomain.com
SUPPORT_EMAIL=briankirui275@gmail.com
SUPPORT_PHONE="+254 700 123 456"
COMPANY_ADDRESS="Nairobi, Kenya"

# Admin Notifications
ADMIN_EMAILS=briankirui275@gmail.com
TEST_EMAIL=briankirui275@gmail.com

# Email Settings
EMAIL_QUEUE_ENABLED=true
EMAIL_BOOKING_CONFIRMATION=true
EMAIL_PAYMENT_CONFIRMATION=true
EMAIL_PAYMENT_REMINDER=true
EMAIL_ADMIN_NOTIFICATIONS=true
EMAIL_THEME_COLOR=#007bff