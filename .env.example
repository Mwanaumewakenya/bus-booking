# Application Environment Configuration Example
# Copy this file to .env and configure your settings

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_NAME="Bus Booking System"

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=bus_booking
DB_USERNAME=root
DB_PASSWORD=

# Session Configuration
SESSION_LIFETIME=120
SESSION_COOKIE=bus_booking_session
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=

# Security Settings
BCRYPT_ROUNDS=12

# Logging
LOG_LEVEL=info
LOG_CHANNEL=file

# Email Configuration (for future notifications)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# Cache Configuration
CACHE_DRIVER=file
CACHE_PREFIX=bus_booking_

# File Storage
FILESYSTEM_DRIVER=local

# M-Pesa Configuration (Safaricom Daraja API)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379